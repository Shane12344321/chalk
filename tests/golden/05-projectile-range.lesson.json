{
  "schema_version": "1.0",
  "title": "Projectile range versus angle",
  "steps": [
    {
      "id": "s1",
      "script": "Launch angle changes how horizontal and vertical motion share the same speed.",
      "ops": [
        { "op": "text", "id": "title", "region": "A1", "content": "Projectile range" },
        { "op": "axes", "id": "axes1", "region": "right", "x": { "min": 0, "max": 90, "label": "angle" }, "y": { "min": 0, "max": 1.1, "label": "range" } }
      ],
      "checkpoint": null
    },
    {
      "id": "s2",
      "script": "Sine of twice the angle peaks when the launch angle is forty-five degrees.",
      "ops": [
        { "op": "curve", "id": "curve1", "axes_id": "axes1", "expr": "sin(2*x*pi/180)", "domain": [0, 90] },
        { "op": "equation", "id": "eq1", "region": "B2", "latex": "R\\propto\\sin(2\\theta)" }
      ],
      "checkpoint": { "question": "Where does the range curve peak?", "expected_gist": "45 degrees" }
    }
  ]
}
