{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chalk.local/schema/phase6-sync-evidence.schema.json",
  "title": "CHALK Phase 6 synchronization evidence",
  "description": "Content-free, terminal evidence for the separately owner-approved Phase 6A and 6B comparisons. Script text, transcripts, RMS samples, audio, and credentials are intentionally absent.",
  "oneOf": [
    { "$ref": "#/$defs/audioActivityComparison" },
    { "$ref": "#/$defs/sentenceResponseComparison" }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,47}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timeMs": {
      "type": "number",
      "minimum": 0,
      "maximum": 300000
    },
    "signedTimeMs": {
      "type": "number",
      "minimum": -300000,
      "maximum": 300000
    },
    "nullableTimeMs": {
      "oneOf": [
        { "$ref": "#/$defs/timeMs" },
        { "type": "null" }
      ]
    },
    "nullableSignedTimeMs": {
      "oneOf": [
        { "$ref": "#/$defs/signedTimeMs" },
        { "type": "null" }
      ]
    },
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cached_lesson_id",
        "step_id",
        "script_sha256",
        "model",
        "voice",
        "browser_label",
        "sync_mode"
      ],
      "properties": {
        "cached_lesson_id": {
          "enum": ["projectile", "derivative", "unit-circle"]
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,15}$"
        },
        "script_sha256": { "$ref": "#/$defs/sha256" },
        "model": {
          "type": "string",
          "pattern": "^gpt-realtime-[a-z0-9.-]{1,31}$"
        },
        "voice": { "enum": ["marin", "cedar"] },
        "browser_label": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,47}$"
        },
        "sync_mode": { "const": "fixed" }
      }
    },
    "detectorConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_revision",
        "activity_threshold_rms",
        "active_frames",
        "silent_frames",
        "fft_size",
        "false_pause_min_ms"
      ],
      "properties": {
        "policy_revision": { "const": "rms-hysteresis-v1" },
        "activity_threshold_rms": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.2
        },
        "active_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "silent_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "fft_size": { "const": 1024 },
        "false_pause_min_ms": { "const": 80 }
      }
    },
    "activityTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "at_ms"],
      "properties": {
        "active": { "type": "boolean" },
        "at_ms": { "$ref": "#/$defs/timeMs" }
      }
    },
    "audibleReferenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "$ref": "#/$defs/timeMs" },
        "end_ms": { "$ref": "#/$defs/timeMs" }
      }
    },
    "audioMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_start_latency_ms",
        "activity_stop_offset_ms",
        "false_pause_count",
        "false_pause_total_ms",
        "max_sample_cost_ms",
        "samples"
      ],
      "properties": {
        "activity_start_latency_ms": { "$ref": "#/$defs/nullableSignedTimeMs" },
        "activity_stop_offset_ms": { "$ref": "#/$defs/nullableSignedTimeMs" },
        "false_pause_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "false_pause_total_ms": { "$ref": "#/$defs/timeMs" },
        "max_sample_cost_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "audioActivityRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "run_id",
        "identity",
        "detector",
        "response_call_ceiling",
        "response_calls",
        "outcome",
        "window_start_ms",
        "window_end_ms",
        "buffer_started_ms",
        "buffer_stopped_ms",
        "transitions",
        "audible_reference",
        "metrics",
        "interruption",
        "human_preference"
      ],
      "properties": {
        "experiment_id": { "$ref": "#/$defs/safeId" },
        "run_id": { "$ref": "#/$defs/safeId" },
        "identity": { "$ref": "#/$defs/runIdentity" },
        "detector": { "$ref": "#/$defs/detectorConfiguration" },
        "response_call_ceiling": { "const": 1 },
        "response_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "outcome": {
          "enum": ["completed", "unsupported", "response_failed", "interrupted", "aborted", "stale"]
        },
        "window_start_ms": { "$ref": "#/$defs/timeMs" },
        "window_end_ms": { "$ref": "#/$defs/timeMs" },
        "buffer_started_ms": { "$ref": "#/$defs/nullableTimeMs" },
        "buffer_stopped_ms": { "$ref": "#/$defs/nullableTimeMs" },
        "transitions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/activityTransition" }
        },
        "audible_reference": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/audibleReferenceWindow" }
        },
        "metrics": { "$ref": "#/$defs/audioMetrics" },
        "interruption": { "enum": ["not_exercised", "preserved", "regressed"] },
        "human_preference": { "enum": ["improved", "flat", "worse", "not_rated"] }
      }
    },
    "audioActivityComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "experiment_id",
        "status",
        "request_call_ceiling",
        "runs",
        "decision"
      ],
      "properties": {
        "schema": { "const": "chalk.phase6-audio-activity-comparison.v1" },
        "experiment_id": { "$ref": "#/$defs/safeId" },
        "status": { "const": "completed" },
        "request_call_ceiling": { "const": 3 },
        "runs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/audioActivityRun" }
        },
        "decision": { "enum": ["promote", "park", "remove"] }
      }
    },
    "sentenceSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "outcome",
        "requested_at_ms",
        "activity_at_ms",
        "generation_done_at_ms",
        "playback_stopped_at_ms"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 4 },
        "outcome": { "enum": ["completed", "response_failed", "interrupted", "aborted", "stale"] },
        "requested_at_ms": { "$ref": "#/$defs/timeMs" },
        "activity_at_ms": { "$ref": "#/$defs/nullableTimeMs" },
        "generation_done_at_ms": { "$ref": "#/$defs/nullableTimeMs" },
        "playback_stopped_at_ms": { "$ref": "#/$defs/nullableTimeMs" }
      }
    },
    "sentenceResponseTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "run_id",
        "identity",
        "mode",
        "planned_responses",
        "response_call_ceiling",
        "requested_responses",
        "completed_responses",
        "failed_responses",
        "terminal_reason",
        "segments",
        "total_latency_ms",
        "inter_response_gap_ms"
      ],
      "properties": {
        "experiment_id": { "$ref": "#/$defs/safeId" },
        "run_id": { "$ref": "#/$defs/safeId" },
        "identity": { "$ref": "#/$defs/runIdentity" },
        "mode": { "enum": ["single_response", "per_sentence"] },
        "planned_responses": { "type": "integer", "minimum": 1, "maximum": 5 },
        "response_call_ceiling": { "type": "integer", "minimum": 1, "maximum": 5 },
        "requested_responses": { "type": "integer", "minimum": 0, "maximum": 5 },
        "completed_responses": { "type": "integer", "minimum": 0, "maximum": 5 },
        "failed_responses": { "type": "integer", "minimum": 0, "maximum": 1 },
        "terminal_reason": { "enum": ["completed", "response_failed", "interrupted", "aborted", "stale"] },
        "segments": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/sentenceSegment" }
        },
        "total_latency_ms": { "$ref": "#/$defs/nullableTimeMs" },
        "inter_response_gap_ms": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/timeMs" }
        }
      }
    },
    "sentenceHumanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_mode",
        "single_naturalness",
        "per_sentence_naturalness",
        "interruption_behavior"
      ],
      "properties": {
        "preferred_mode": { "enum": ["single_response", "per_sentence", "tie"] },
        "single_naturalness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "per_sentence_naturalness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "interruption_behavior": { "enum": ["not_exercised", "preserved", "regressed"] }
      }
    },
    "sentenceResponseComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "experiment_id",
        "status",
        "request_call_ceiling",
        "single_response",
        "per_sentence",
        "human_review",
        "decision"
      ],
      "properties": {
        "schema": { "const": "chalk.phase6-sentence-response-comparison.v1" },
        "experiment_id": { "$ref": "#/$defs/safeId" },
        "status": { "const": "completed" },
        "request_call_ceiling": { "type": "integer", "minimum": 3, "maximum": 6 },
        "single_response": { "$ref": "#/$defs/sentenceResponseTrial" },
        "per_sentence": { "$ref": "#/$defs/sentenceResponseTrial" },
        "human_review": { "$ref": "#/$defs/sentenceHumanReview" },
        "decision": { "enum": ["promote", "park", "remove"] }
      }
    }
  }
}
