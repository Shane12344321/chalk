{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chalk.local/schema/lesson-stream.schema.json",
  "title": "LessonStreamEnvelope",
  "description": "Validated backend-to-browser NDJSON envelopes for live lesson generation.",
  "oneOf": [
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/step" },
    { "$ref": "#/$defs/inkDelta" },
    { "$ref": "#/$defs/warning" },
    { "$ref": "#/$defs/done" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "title"],
      "properties": {
        "type": { "const": "lesson.started" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "plan"],
      "properties": {
        "type": { "const": "lesson.plan" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "plan": { "$ref": "lesson-plan.schema.json" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "step"],
      "properties": {
        "type": { "const": "lesson.step" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "step": {
          "$ref": "lesson.schema.json#/$defs/step"
        }
      }
    },
    "inkDelta": {
      "description": "Experimental append-only ink prefix. The server may emit this only after accepting a bounded operation header; normal and cached lesson paths never emit it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "request_id", "step_id", "op_id", "stroke_index", "sequence", "points", "complete"
      ],
      "properties": {
        "type": { "const": "lesson.ink_delta" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "step_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,15}$" },
        "op_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,15}$" },
        "stroke_index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "complete": { "type": "boolean" }
      }
    },
    "warning": {
      "oneOf": [
        { "$ref": "#/$defs/standardWarning" },
        { "$ref": "#/$defs/sanitizedWarning" }
      ]
    },
    "standardWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code"],
      "properties": {
        "type": { "const": "lesson.warning" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "code": {
          "enum": ["step_repaired", "step_dropped", "truncated_output"]
        },
        "step_hint": { "type": "string", "maxLength": 16 }
      }
    },
    "sanitizedWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "request_id", "code", "corrections", "correction_count"
      ],
      "properties": {
        "type": { "const": "lesson.warning" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "code": { "const": "step_sanitized" },
        "step_hint": { "type": "string", "maxLength": 16 },
        "corrections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trimmed_outer_whitespace",
              "normalized_power_operator",
              "clamped_anchor_gap",
              "clamped_normalized_point"
            ]
          }
        },
        "correction_count": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "accepted_steps", "repairs", "dropped_steps"],
      "allOf": [
        {
          "if": {
            "required": ["continuation_available"],
            "properties": { "continuation_available": { "const": true } }
          },
          "then": {
            "required": ["continuation_receipt"],
            "properties": { "continuation_receipt": { "type": "string" } }
          }
        },
        {
          "if": { "required": ["continuation_receipt"] },
          "then": {
            "required": ["continuation_available"],
            "properties": { "continuation_available": { "const": true } }
          }
        }
      ],
      "properties": {
        "type": { "const": "lesson.done" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "accepted_steps": { "type": "integer", "minimum": 1, "maximum": 8 },
        "repairs": { "type": "integer", "minimum": 0, "maximum": 4 },
        "dropped_steps": { "type": "integer", "minimum": 0, "maximum": 8 },
        "sanitized_steps": { "type": "integer", "minimum": 0, "maximum": 8 },
        "sanitized_fields": { "type": "integer", "minimum": 0, "maximum": 512 },
        "continuation_available": { "type": "boolean" },
        "continuation_receipt": {
          "type": "string",
          "minLength": 96,
          "maxLength": 1024,
          "pattern": "^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "error": {
      "oneOf": [
        { "$ref": "#/$defs/upstreamError" },
        { "$ref": "#/$defs/localError" }
      ]
    },
    "upstreamError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code", "fallback_available"],
      "properties": {
        "type": { "const": "lesson.error" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "code": {
          "enum": [
            "upstream_rejected",
            "upstream_failed",
            "upstream_incomplete",
            "upstream_error"
          ]
        },
        "upstream_reason": {
          "enum": [
            "max_output_tokens",
            "content_filter",
            "rate_limit",
            "authentication",
            "permission",
            "server_error",
            "invalid_request",
            "unknown"
          ]
        },
        "failure_origin": { "enum": ["generation", "repair"] },
        "repair_attempts": { "type": "integer", "minimum": 0, "maximum": 4 },
        "fallback_available": { "const": true }
      }
    },
    "localError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code", "fallback_available"],
      "properties": {
        "type": { "const": "lesson.error" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "code": {
          "enum": [
            "not_configured",
            "upstream_unavailable",
            "generation_timeout",
            "invalid_stream",
            "no_valid_steps"
          ]
        },
        "failure_origin": { "enum": ["generation", "repair"] },
        "repair_attempts": { "type": "integer", "minimum": 0, "maximum": 4 },
        "fallback_available": { "const": true }
      }
    }
  }
}
