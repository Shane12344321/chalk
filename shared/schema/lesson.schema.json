{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chalk.local/schema/lesson.schema.json",
  "title": "LessonProgram",
  "description": "CHALK M2 deterministic lesson wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "steps"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2", "1.3", "1.4"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "elementId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,15}$"
    },
    "region": {
      "type": "string",
      "enum": [
        "A1", "A2", "A3", "B1", "B2", "B3",
        "C1", "C2", "C3", "D1", "D2", "D3",
        "left", "right", "full"
      ]
    },
    "anchor": {
      "title": "Anchor",
      "type": "object",
      "additionalProperties": false,
      "required": ["el", "side"],
      "properties": {
        "el": { "$ref": "#/$defs/elementId" },
        "side": { "enum": ["above", "below", "left", "right"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "layoutPlace": {
      "title": "LayoutPlace",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "relative_to", "side", "align", "gap"],
      "properties": {
        "kind": { "const": "place" },
        "id": { "$ref": "#/$defs/elementId" },
        "relative_to": { "$ref": "#/$defs/elementId" },
        "side": { "enum": ["above", "below", "left", "right"] },
        "align": { "enum": ["start", "center", "end"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 0.25 }
      }
    },
    "layoutAlign": {
      "title": "LayoutAlign",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ids", "axis", "alignment"],
      "properties": {
        "kind": { "const": "align" },
        "ids": {
          "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/elementId" }
        },
        "axis": { "enum": ["horizontal", "vertical"] },
        "alignment": { "enum": ["start", "center", "end"] }
      }
    },
    "layoutStack": {
      "title": "LayoutStack",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ids", "direction", "align", "gap"],
      "properties": {
        "kind": { "const": "stack" },
        "ids": {
          "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/elementId" }
        },
        "direction": { "enum": ["horizontal", "vertical"] },
        "align": { "enum": ["start", "center", "end"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 0.25 }
      }
    },
    "layoutDistribute": {
      "title": "LayoutDistribute",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ids", "direction"],
      "properties": {
        "kind": { "const": "distribute" },
        "ids": {
          "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/elementId" }
        },
        "direction": { "enum": ["horizontal", "vertical"] }
      }
    },
    "layoutRelation": {
      "title": "LayoutRelation",
      "oneOf": [
        { "$ref": "#/$defs/layoutPlace" },
        { "$ref": "#/$defs/layoutAlign" },
        { "$ref": "#/$defs/layoutStack" },
        { "$ref": "#/$defs/layoutDistribute" }
      ]
    },
    "axisSpec": {
      "title": "AxisSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "label"],
      "properties": {
        "min": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "max": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "label": { "type": "string", "maxLength": 32 }
      }
    },
    "normalizedPoint": {
      "title": "NormalizedPoint",
      "type": "array",
      "items": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2
    },
    "geometryPointReference": {
      "title": "GeometryPointReference",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "element_id"],
          "properties": {
            "kind": { "const": "point" },
            "element_id": { "$ref": "#/$defs/elementId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "element_id", "endpoint"],
          "properties": {
            "kind": { "const": "endpoint" },
            "element_id": { "$ref": "#/$defs/elementId" },
            "endpoint": { "enum": ["start", "end"] }
          }
        }
      ]
    },
    "alongConstruction": {
      "title": "AlongConstruction",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element_id", "t"],
      "properties": {
        "kind": { "const": "along" },
        "element_id": { "$ref": "#/$defs/elementId" },
        "t": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "midpointConstruction": {
      "title": "MidpointConstruction",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "a", "b"],
      "properties": {
        "kind": { "const": "midpoint_of" },
        "a": { "$ref": "#/$defs/geometryPointReference" },
        "b": { "$ref": "#/$defs/geometryPointReference" }
      }
    },
    "intersectionConstruction": {
      "title": "IntersectionConstruction",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "a", "b"],
      "properties": {
        "kind": { "const": "intersection_of" },
        "a": { "$ref": "#/$defs/elementId" },
        "b": { "$ref": "#/$defs/elementId" }
      }
    },
    "offsetConstruction": {
      "title": "OffsetConstruction",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element_id", "side", "gap"],
      "properties": {
        "kind": { "const": "offset_from" },
        "element_id": { "$ref": "#/$defs/elementId" },
        "side": { "enum": ["above", "below", "left", "right"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 0.25 }
      }
    },
    "pointConstruction": {
      "title": "PointConstruction",
      "oneOf": [
        { "$ref": "#/$defs/alongConstruction" },
        { "$ref": "#/$defs/midpointConstruction" },
        { "$ref": "#/$defs/intersectionConstruction" },
        { "$ref": "#/$defs/offsetConstruction" }
      ]
    },
    "perpendicularConstruction": {
      "title": "PerpendicularConstruction",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "line", "point", "length"],
      "properties": {
        "kind": { "const": "perpendicular_through" },
        "line": { "$ref": "#/$defs/elementId" },
        "point": { "$ref": "#/$defs/geometryPointReference" },
        "length": { "type": "number", "minimum": 0.02, "maximum": 1 }
      }
    },
    "tangentConstruction": {
      "title": "TangentConstruction",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "curve", "x", "length"],
      "properties": {
        "kind": { "const": "tangent_at" },
        "curve": { "$ref": "#/$defs/elementId" },
        "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "length": { "type": "number", "minimum": 0.02, "maximum": 1 }
      }
    },
    "lineConstruction": {
      "title": "LineConstruction",
      "oneOf": [
        { "$ref": "#/$defs/perpendicularConstruction" },
        { "$ref": "#/$defs/tangentConstruction" }
      ]
    },
    "textRegionOp": {
      "title": "TextRegionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "content"],
      "properties": {
        "op": { "const": "text" },
        "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "content": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "textAnchorOp": {
      "title": "TextAnchorOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "anchor", "content"],
      "properties": {
        "op": { "const": "text" },
        "id": { "$ref": "#/$defs/elementId" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "content": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "textOp": {
      "title": "TextOp",
      "oneOf": [
        { "$ref": "#/$defs/textRegionOp" },
        { "$ref": "#/$defs/textAnchorOp" }
      ]
    },
    "equationRegionOp": {
      "title": "EquationRegionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "latex"],
      "properties": {
        "op": { "const": "equation" },
        "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "latex": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "equationAnchorOp": {
      "title": "EquationAnchorOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "anchor", "latex"],
      "properties": {
        "op": { "const": "equation" },
        "id": { "$ref": "#/$defs/elementId" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "latex": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "equationOp": {
      "title": "EquationOp",
      "oneOf": [
        { "$ref": "#/$defs/equationRegionOp" },
        { "$ref": "#/$defs/equationAnchorOp" }
      ]
    },
    "sketchOp": {
      "title": "SketchOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "strokes"],
      "properties": {
        "op": { "const": "sketch" },
        "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 },
        "strokes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 40,
            "items": { "$ref": "#/$defs/normalizedPoint" }
          }
        }
      }
    },
    "axesOp": {
      "title": "AxesOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "x", "y"],
      "properties": {
        "op": { "const": "axes" },
        "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "x": { "$ref": "#/$defs/axisSpec" },
        "y": { "$ref": "#/$defs/axisSpec" }
      }
    },
    "curveOp": {
      "title": "CurveOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "axes_id", "expr"],
      "properties": {
        "op": { "const": "curve" },
        "id": { "$ref": "#/$defs/elementId" },
        "axes_id": { "$ref": "#/$defs/elementId" },
        "expr": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": {
          "type": "array",
          "items": [
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "strokeStyle": {
      "type": "string",
      "enum": ["solid", "dashed"]
    },
    "diagramLinePrimitive": {
      "title": "DiagramLinePrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points", "stroke"],
      "properties": {
        "kind": { "const": "line" },
        "points": {
          "type": "array", "minItems": 2, "maxItems": 12,
          "items": { "$ref": "#/$defs/normalizedPoint" }
        },
        "stroke": { "$ref": "#/$defs/strokeStyle" },
        "arrow": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramSmoothPrimitive": {
      "title": "DiagramSmoothPrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points", "stroke"],
      "properties": {
        "kind": { "const": "smooth" },
        "points": {
          "type": "array", "minItems": 3, "maxItems": 12,
          "items": { "$ref": "#/$defs/normalizedPoint" }
        },
        "stroke": { "$ref": "#/$defs/strokeStyle" },
        "arrow": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramRectPrimitive": {
      "title": "DiagramRectPrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to", "stroke"],
      "properties": {
        "kind": { "const": "rect" },
        "from": { "$ref": "#/$defs/normalizedPoint" },
        "to": { "$ref": "#/$defs/normalizedPoint" },
        "stroke": { "$ref": "#/$defs/strokeStyle" },
        "fill": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramEllipsePrimitive": {
      "title": "DiagramEllipsePrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "center", "radius", "stroke"],
      "properties": {
        "kind": { "const": "ellipse" },
        "center": { "$ref": "#/$defs/normalizedPoint" },
        "radius": {
          "type": "array",
          "items": [
            { "type": "number", "minimum": 0.02, "maximum": 0.5 },
            { "type": "number", "minimum": 0.02, "maximum": 0.5 }
          ],
          "additionalItems": false, "minItems": 2, "maxItems": 2
        },
        "stroke": { "$ref": "#/$defs/strokeStyle" },
        "fill": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramArcPrimitive": {
      "title": "DiagramArcPrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "center", "radius", "start_deg", "end_deg", "stroke"],
      "properties": {
        "kind": { "const": "arc" },
        "center": { "$ref": "#/$defs/normalizedPoint" },
        "radius": {
          "type": "array",
          "items": [
            { "type": "number", "minimum": 0.02, "maximum": 0.5 },
            { "type": "number", "minimum": 0.02, "maximum": 0.5 }
          ],
          "additionalItems": false, "minItems": 2, "maxItems": 2
        },
        "start_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "end_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "stroke": { "$ref": "#/$defs/strokeStyle" },
        "arrow": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramTextPrimitive": {
      "title": "DiagramTextPrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at", "content"],
      "properties": {
        "kind": { "const": "text" },
        "at": { "$ref": "#/$defs/normalizedPoint" },
        "content": { "type": "string", "minLength": 1, "maxLength": 32 },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "size": { "type": "string", "enum": ["small", "normal", "large"] },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramPointPrimitive": {
      "title": "DiagramPointPrimitive",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at"],
      "properties": {
        "kind": { "const": "point" },
        "at": { "$ref": "#/$defs/normalizedPoint" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "diagramPrimitive": {
      "title": "DiagramPrimitive",
      "oneOf": [
        { "$ref": "#/$defs/diagramLinePrimitive" },
        { "$ref": "#/$defs/diagramSmoothPrimitive" },
        { "$ref": "#/$defs/diagramRectPrimitive" },
        { "$ref": "#/$defs/diagramEllipsePrimitive" },
        { "$ref": "#/$defs/diagramArcPrimitive" },
        { "$ref": "#/$defs/diagramTextPrimitive" },
        { "$ref": "#/$defs/diagramPointPrimitive" }
      ]
    },
    "diagramOp": {
      "title": "DiagramOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "primitives"],
      "properties": {
        "op": { "const": "diagram" },
        "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "primitives": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "$ref": "#/$defs/diagramPrimitive" }
        },
        "tension": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "lineOp": {
      "title": "LineOp",
      "oneOf": [
        { "$ref": "#/$defs/lineRegionOp" },
        { "$ref": "#/$defs/lineCanvasOp" },
        { "$ref": "#/$defs/lineConstructionOp" }
      ]
    },
    "lineConstructionOp": {
      "title": "LineConstructionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "construct", "stroke"],
      "properties": {
        "op": { "const": "line" },
        "id": { "$ref": "#/$defs/elementId" },
        "construct": { "$ref": "#/$defs/lineConstruction" },
        "stroke": { "$ref": "#/$defs/strokeStyle" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "lineRegionOp": {
      "title": "LineRegionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "from", "to", "stroke"],
      "properties": {
        "op": { "const": "line" }, "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "from": { "$ref": "#/$defs/normalizedPoint" }, "to": { "$ref": "#/$defs/normalizedPoint" },
        "stroke": { "$ref": "#/$defs/strokeStyle" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "lineCanvasOp": {
      "title": "LineCanvasOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "canvas_id", "from", "to", "stroke"],
      "properties": {
        "op": { "const": "line" }, "id": { "$ref": "#/$defs/elementId" },
        "canvas_id": { "$ref": "#/$defs/elementId" },
        "from": { "$ref": "#/$defs/normalizedPoint" }, "to": { "$ref": "#/$defs/normalizedPoint" },
        "stroke": { "$ref": "#/$defs/strokeStyle" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "arrowOp": {
      "title": "ArrowOp",
      "oneOf": [
        { "$ref": "#/$defs/arrowRegionOp" },
        { "$ref": "#/$defs/arrowCanvasOp" }
      ]
    },
    "arrowRegionOp": {
      "title": "ArrowRegionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "from", "to", "stroke"],
      "properties": {
        "op": { "const": "arrow" }, "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" },
        "from": { "$ref": "#/$defs/normalizedPoint" }, "to": { "$ref": "#/$defs/normalizedPoint" },
        "stroke": { "$ref": "#/$defs/strokeStyle" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "arrowCanvasOp": {
      "title": "ArrowCanvasOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "canvas_id", "from", "to", "stroke"],
      "properties": {
        "op": { "const": "arrow" }, "id": { "$ref": "#/$defs/elementId" },
        "canvas_id": { "$ref": "#/$defs/elementId" },
        "from": { "$ref": "#/$defs/normalizedPoint" }, "to": { "$ref": "#/$defs/normalizedPoint" },
        "stroke": { "$ref": "#/$defs/strokeStyle" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "pointOp": {
      "title": "PointOp",
      "oneOf": [
        { "$ref": "#/$defs/pointRegionOp" },
        { "$ref": "#/$defs/pointCanvasOp" },
        { "$ref": "#/$defs/pointConstructionOp" }
      ]
    },
    "pointConstructionOp": {
      "title": "PointConstructionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "construct"],
      "properties": {
        "op": { "const": "point" },
        "id": { "$ref": "#/$defs/elementId" },
        "construct": { "$ref": "#/$defs/pointConstruction" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "pointRegionOp": {
      "title": "PointRegionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "at"],
      "properties": {
        "op": { "const": "point" }, "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" }, "at": { "$ref": "#/$defs/normalizedPoint" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "pointCanvasOp": {
      "title": "PointCanvasOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "canvas_id", "at"],
      "properties": {
        "op": { "const": "point" }, "id": { "$ref": "#/$defs/elementId" },
        "canvas_id": { "$ref": "#/$defs/elementId" }, "at": { "$ref": "#/$defs/normalizedPoint" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "angleArcOp": {
      "title": "AngleArcOp",
      "oneOf": [
        { "$ref": "#/$defs/angleArcRegionOp" },
        { "$ref": "#/$defs/angleArcCanvasOp" }
      ]
    },
    "angleArcRegionOp": {
      "title": "AngleArcRegionOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "region", "center", "radius", "start_deg", "end_deg", "stroke"],
      "properties": {
        "op": { "const": "angle_arc" }, "id": { "$ref": "#/$defs/elementId" },
        "region": { "$ref": "#/$defs/region" }, "center": { "$ref": "#/$defs/normalizedPoint" },
        "radius": { "type": "number", "minimum": 0.02, "maximum": 0.5 },
        "start_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "end_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "stroke": { "$ref": "#/$defs/strokeStyle" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "angleArcCanvasOp": {
      "title": "AngleArcCanvasOp",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "canvas_id", "center", "radius", "start_deg", "end_deg", "stroke"],
      "properties": {
        "op": { "const": "angle_arc" }, "id": { "$ref": "#/$defs/elementId" },
        "canvas_id": { "$ref": "#/$defs/elementId" }, "center": { "$ref": "#/$defs/normalizedPoint" },
        "radius": { "type": "number", "minimum": 0.02, "maximum": 0.5 },
        "start_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "end_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "stroke": { "$ref": "#/$defs/strokeStyle" }, "label": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "op": {
      "title": "LessonOp",
      "oneOf": [
        { "$ref": "#/$defs/textOp" },
        { "$ref": "#/$defs/equationOp" },
        { "$ref": "#/$defs/sketchOp" },
        { "$ref": "#/$defs/axesOp" },
        { "$ref": "#/$defs/curveOp" },
        { "$ref": "#/$defs/diagramOp" },
        { "$ref": "#/$defs/lineOp" },
        { "$ref": "#/$defs/arrowOp" },
        { "$ref": "#/$defs/pointOp" },
        { "$ref": "#/$defs/angleArcOp" }
      ]
    },
    "checkpoint": {
      "title": "Checkpoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "expected_gist"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 120 },
        "expected_gist": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "step": {
      "title": "LessonStep",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "script", "ops", "checkpoint"],
      "properties": {
        "id": { "$ref": "#/$defs/elementId" },
        "script": { "type": "string", "minLength": 1, "maxLength": 240 },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/op" }
        },
        "layout": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/layoutRelation" }
        },
        "checkpoint": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/checkpoint" }
          ]
        }
      }
    }
  }
}
