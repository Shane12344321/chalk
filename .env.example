# CHALK is a localhost-only prototype. Copy this file to .env at the repository
# root. Never place this key in frontend/ or in any VITE_* variable.
OPENAI_API_KEY=

# The tldraw SDK licence is needed only when the experimental browser flag
# VITE_BOARD_RENDERER=tldraw is deliberately enabled. Keep the licence here on
# the backend; /runtime-config/renderer projects it with no-store semantics to
# the localhost SDK. Never place it in a VITE_* variable or commit the value.
TLDRAW_LICENSE_KEY=

# Non-secret frontend runtime switches must be supplied to Vite deliberately.
# CHALK_MODE is an operational demo/diagnostics switch, not a product experiment.
# The shipped/default renderer remains rough-svg; tldraw is lazy-loaded only for
# the isolated comparison path. Partial ink has no backend producer yet.
VITE_CHALK_MODE=demo
VITE_BOARD_RENDERER=rough-svg
VITE_PARTIAL_INK=off
# The renderer-feedback loop is implemented but remains opt-in until its live
# quality/latency gate passes. `one-shot` is the dependable rollback.
VITE_LESSON_GENERATION=one-shot
# Q&A direct drawing is a bounded Realtime-tool experiment. `off` preserves the
# board-model annotation path; `on` adds validated two-mark local Q&A overlays.
VITE_QA_DIRECT_DRAW=off
# Temporary trace/focus choreography remains opt-in until the Phase 5 human
# cached-loop gate passes. `off` preserves the existing local deixis behavior.
VITE_ATTENTION_CHOREOGRAPHY=off
# Phase-6 evaluation only: record broad remote-audio activity transitions. It
# does not pace ink or infer words, and remains off until its bounded live gate.
VITE_REMOTE_AUDIO_ACTIVITY=off

# Development defaults. Use gpt-realtime-2.1 only for final recording after the
# mini-model path passes the live M1 gate.
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin

# Non-secret domain-separation value used to hash the browser's random client
# UUID before it becomes OpenAI-Safety-Identifier. Choose a deliberate per-app
# value outside this localhost prototype; this is not an authentication secret.
SAFETY_IDENTIFIER_SALT=chalk-local-development-v1

# Luna is the lowest-cost current GPT-5.6 tier and must pass the unchanged M3
# rubric. `none` is the latency baseline; compare `low` only for measured quality.
# Escalate failed cases to Terra only after reviewing Luna evidence.
BOARD_MODEL=gpt-5.6-luna
BOARD_REASONING_EFFORT=none
# v3 adds the explicit spatial contract: grid geometry, y-down sketch
# coordinates, curve domain rules, and a sketch worked example. v2 preserves
# the accumulated-whiteboard playbook; v1 preserves the prompt used by the
# retained 2026-07-16 qualification batch as a known-good fallback.
BOARD_PROMPT_VERSION=v3
LESSON_GENERATION_TIMEOUT_SECONDS=30
LESSON_MAX_CONCURRENT=2
# Annotation uses a separate single-request lane. One request makes one primary
# board-model call and may make at most two counted repair calls.
ANNOTATION_GENERATION_TIMEOUT_SECONDS=15
ANNOTATION_MAX_CONCURRENT=1
# Density-aware target-relative side allowlists are implemented but opt-in until
# the Phase-7 retained annotation gate proves placement without repair regression.
ANNOTATION_WHITESPACE=off
# Fixed mode starts on observed playback activity and uses a bounded word-count
# schedule. Paced mode is experimental because transcript generation can run
# ahead of what the student is actually hearing.
SYNC_MODE=fixed
DRAWBACK_MODE=vision

# Exact allowed browser origin. Do not replace with * when credentials are used.
FRONTEND_ORIGIN=http://localhost:5173
