{
  "schema_version": "1.0",
  "title": "Derivative as slope at a point",
  "steps": [
    {
      "id": "s1",
      "script": "A derivative measures the local slope of a curve at one chosen point.",
      "ops": [
        { "op": "text", "id": "title", "region": "A1", "content": "Derivative = local slope" },
        { "op": "axes", "id": "axes1", "region": "right", "x": { "min": -2, "max": 2, "label": "x" }, "y": { "min": 0, "max": 4, "label": "y" } }
      ],
      "checkpoint": null
    },
    {
      "id": "s2",
      "script": "For x squared, the tangent at x equals one has slope two.",
      "ops": [
        { "op": "curve", "id": "curve1", "axes_id": "axes1", "expr": "x^2", "domain": [-2, 2] },
        { "op": "text", "id": "eq1", "region": "B2", "content": "f′(1) = 2" }
      ],
      "checkpoint": { "question": "Is the curve rising at x equals one?", "expected_gist": "yes" }
    }
  ]
}
