{"type":"lesson.step","request_id":"ec27a004-d216-4fcf-bf9a-0ed98891ae27","step":{"id":"s1","script":"For a launch and landing at the same height, range depends on the launch angle.","ops":[{"op":"text","id":"title","region":"A1","content":"Projectile range versus angle"},{"op":"equation","id":"rangeformula","region":"A2","latex":"R(\\theta)=\\frac{v_0^2\\sin(2\\theta)}{g}"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"ec27a004-d216-4fcf-bf9a-0ed98891ae27","step":{"id":"s2","script":"With launch speed fixed, the sine factor controls the range.","ops":[{"op":"axes","id":"rangeaxes","region":"right","x":{"min":0,"max":90,"label":"angle θ (degrees)"},"y":{"min":0,"max":1.1,"label":"relative range"}},{"op":"curve","id":"rangecurve","axes_id":"rangeaxes","expr":"sin(2*pi*x/180)","domain":[0,90]}],"checkpoint":{"question":"At which angle is the range greatest?","expected_gist":"45 degrees"}}}
{"type":"lesson.step","request_id":"ec27a004-d216-4fcf-bf9a-0ed98891ae27","step":{"id":"s3","script":"The curve peaks at forty-five degrees because sin of twice the angle reaches one.","ops":[{"op":"text","id":"peaklabel","anchor":{"el":"rangeaxes","side":"below","gap":0.06},"content":"maximum at θ = 45°"},{"op":"equation","id":"maximum","region":"B2","latex":"R_{\\max}=\\frac{v_0^2}{g}"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"ec27a004-d216-4fcf-bf9a-0ed98891ae27","step":{"id":"s4","script":"Angles equally spaced around forty-five degrees produce equal ranges, such as thirty and sixty degrees.","ops":[{"op":"equation","id":"symmetry","region":"B3","latex":"R(30^\\circ)=R(60^\\circ)"}],"checkpoint":null}}
