{"type":"lesson.step","request_id":"4b15b1c1-f3d5-442f-866c-77871e0e6513","step":{"id":"s1","script":"Exponential change means the amount changes in proportion to its current size.","ops":[{"op":"text","id":"intro","region":"A1","content":"Exponential growth and decay"},{"op":"equation","id":"model","region":"A2","latex":"N(t)=N_0e^{kt}"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"4b15b1c1-f3d5-442f-866c-77871e0e6513","step":{"id":"s2","script":"A positive k produces growth, while a negative k produces decay.","ops":[{"op":"text","id":"signs","region":"left","content":"k > 0: growth\nk < 0: decay"},{"op":"axes","id":"growthaxes","region":"right","x":{"min":0,"max":5,"label":"time"},"y":{"min":0,"max":9,"label":"amount"}}],"checkpoint":{"question":"What does a negative value of k indicate?","expected_gist":"exponential decay"}}}
{"type":"lesson.step","request_id":"4b15b1c1-f3d5-442f-866c-77871e0e6513","step":{"id":"s3","script":"Here are both patterns, starting from the same initial amount.","ops":[{"op":"curve","id":"growthcurve","axes_id":"growthaxes","expr":"e^(0.4*x)","domain":[0,5]},{"op":"curve","id":"decaycurve","axes_id":"growthaxes","expr":"e^(-0.4*x)","domain":[0,5]},{"op":"text","id":"labels","anchor":{"el":"growthaxes","side":"below","gap":0.05},"content":"growth rises; decay falls"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"4b15b1c1-f3d5-442f-866c-77871e0e6513","step":{"id":"s4","script":"The doubling or halving time is found by setting the exponential factor to two or one-half.","ops":[{"op":"equation","id":"times","region":"B2","latex":"T_{2}={\\ln 2\\over k}\\quad(k>0),\\qquad T_{1/2}={\\ln 2\\over |k|}\\quad(k<0)"}],"checkpoint":null}}
