{"type":"lesson.step","request_id":"51cafb9a-e738-46ff-995a-8a460abe4663","step":{"id":"s1","script":"We will track a point moving around the unit circle and record its vertical height.","ops":[{"op":"text","id":"title","region":"A1","content":"Unit circle → sine wave"},{"op":"axes","id":"circleaxes","region":"left","x":{"min":-1.3,"max":1.3,"label":"x"},"y":{"min":-1.3,"max":1.3,"label":"y"}},{"op":"axes","id":"waveaxes","region":"right","x":{"min":0,"max":6.3,"label":"angle"},"y":{"min":-1.3,"max":1.3,"label":"height"}}],"checkpoint":null}}
{"type":"lesson.step","request_id":"51cafb9a-e738-46ff-995a-8a460abe4663","step":{"id":"s2","script":"At angle theta, the point on the unit circle has coordinates cosine theta and sine theta.","ops":[{"op":"sketch","id":"circle","region":"left","strokes":[[[0.5,0.1],[0.65,0.12],[0.78,0.2],[0.88,0.35],[0.9,0.5],[0.88,0.65],[0.78,0.8],[0.65,0.88],[0.5,0.9],[0.35,0.88],[0.22,0.8],[0.12,0.65],[0.1,0.5],[0.12,0.35],[0.22,0.2],[0.35,0.12],[0.5,0.1]]]},{"op":"equation","id":"coordinates","anchor":{"el":"circleaxes","side":"below","gap":0.06},"latex":"(x,y)=(\\cos\\theta,\\sin\\theta)"},{"op":"text","id":"height","anchor":{"el":"waveaxes","side":"below","gap":0.06},"content":"vertical height = sin theta"}],"checkpoint":{"question":"At angle pi over two, what is the point's vertical height?","expected_gist":"1"}}}
{"type":"lesson.step","request_id":"51cafb9a-e738-46ff-995a-8a460abe4663","step":{"id":"s3","script":"As the angle increases, place each vertical height at its angle on the graph.","ops":[{"op":"curve","id":"sinecurve","axes_id":"waveaxes","expr":"sin(x)","domain":[0,6.3]},{"op":"text","id":"mapping","anchor":{"el":"height","side":"below","gap":0.05},"content":"each circle height becomes one wave point"}],"checkpoint":null}}
