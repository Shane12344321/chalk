{"type":"lesson.step","request_id":"16e7bafb-7c49-4ae6-b29d-b226a48c23fa","step":{"id":"s2","script":"Consider the curve y equals x, from zero to four.","ops":[{"op":"curve","id":"linecurve","axes_id":"areaaxes","expr":"x","domain":[0,4]},{"op":"text","id":"interval","anchor":{"el":"areaaxes","side":"below","gap":0.06},"content":"interval: 0 to 4"}],"checkpoint":{"question":"What shape lies under y equals x from zero to four?","expected_gist":"a triangle"}}}
